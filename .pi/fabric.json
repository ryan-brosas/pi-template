{
  "configVersion": 3,
  "fullCodeMode": true,
  "executor": {
    "memoryLimitBytes": 4294967295
  },
  "schema": {
    "mode": "audit",
    "trustedCommands": {
      "canonical-check": {
        "command": "node",
        "args": [
          "scripts/check.mjs"
        ],
        "shell": false,
        "timeoutMs": 120000
      }
    }
  },
  "compaction": {
    "engine": "pi"
  },
  "prewalk": {
    "mode": "trajectory",
    "model": "opencode-go/deepseek-v4-flash"
  }
}
